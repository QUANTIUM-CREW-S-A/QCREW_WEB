# Supabase - copia este archivo a .env y rellena los valores
# Los encuentras en: Dashboard > Project Settings > API

VITE_SUPABASE_URL=https://<tu-project-ref>.supabase.co

# Usa la clave PUBLISHABLE (sb_publishable_...), nunca la secret/service_role:
# este valor viaja al navegador.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Solo para scripts de servidor (crear usuarios admin, migraciones). Nunca la
# uses en código con prefijo VITE_: Vite la incrustaria en el bundle publico.
SUPABASE_SECRET_KEY=sb_secret_...

# Turnstile (opcional, para el formulario de contacto)
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
